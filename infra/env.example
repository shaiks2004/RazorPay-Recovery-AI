# PostgreSQL runtime configuration
RECOVER_DATABASE_URL=postgresql+psycopg://recover:recover@localhost:5432/recover
RECOVER_RAZORPAY_WEBHOOK_SECRET=replace-with-a-local-webhook-secret
RECOVER_MERCHANT_ID=local-test-merchant
RECOVER_LOG_LEVEL=INFO
RECOVER_RAZORPAY_MODE=test
RECOVER_RAZORPAY_KEY_ID=rzp_test_replace_me
RECOVER_RAZORPAY_KEY_SECRET=replace-with-test-secret
RECOVER_PAYMENT_LINK_EXPIRY_SECONDS=259200
RECOVER_WORKER_LEASE_SECONDS=60
RECOVER_WORKER_MAX_ATTEMPTS=5
RECOVER_WORKER_RETRY_BASE_SECONDS=5
RECOVER_WORKER_RETRY_MAX_SECONDS=300
RECOVER_WORKER_POLL_SECONDS=1
# Optional AI advisory: disabled by default; advisory only, never execution authority.
RECOVER_AI_ADVISOR_ENABLED=false
RECOVER_AI_ADVISOR_PROVIDER=DISABLED
RECOVER_AI_ADVISOR_MODEL=
RECOVER_AI_ADVISOR_TIMEOUT_SECONDS=5
RECOVER_AI_ADVISOR_MAX_OUTPUT_TOKENS=400
RECOVER_AI_ADVISOR_CONFIDENCE_THRESHOLD=0.70
RECOVER_AI_ADVISOR_BASE_URL=
RECOVER_AI_ADVISOR_API_KEY=
# Set true only behind an authenticated reporting-principal integration.
RECOVER_REPORTING_AUTH_REQUIRED=false
